# Kopieren nach .env und anpassen. Ohne .env gelten diese Werte.

# Datenbank (nur lokale Entwicklung)
POSTGRES_DB=atex
POSTGRES_USER=atex
POSTGRES_PASSWORD=atex

# ────────────────────────────────────────────────────────────────
# Sprachmodell / API-Schlüssel
# ────────────────────────────────────────────────────────────────
# Empfohlen: mehrere Modelle in config/modelle.yaml (Vorlage config/modelle.beispiel.yaml,
# Anleitung config/README.md); dann wählt man das Modell je Vorgang in der Oberfläche, und die
# LLM_*-Zeilen unten gelten NICHT. Schlüssel stehen in der Datei oder, mit „api_key_env“, hier:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Ohne config/modelle.yaml: genau ein Modell aus diesen 3 Zeilen. LLM_MODEL ist
# „anbieter/modell“ in der Schreibweise von LiteLLM (Liste der Anbieter in dessen Doku).
# Der Agent läuft auch ganz ohne Modell: Solange INTERNET_LLM und EMAIL_MIT_LLM (unten) auf 0
# stehen, fragt er keins. Die Werte unten sind nur ein Beispiel; LLM_API_BASE leer heißt: die
# Adresse des Anbieters. LLM_API_KEY leer heißt: LiteLLM nimmt den Schlüssel aus der Umgebung
# (z. B. OPENAI_API_KEY).
LLM_MODEL=openai/gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=
#
# Andere Anbieter, statt der 3 Zeilen oben:
#
#   Claude (Anthropic):
#   LLM_MODEL=anthropic/claude-sonnet-5-5
#   LLM_API_BASE=
#   LLM_API_KEY=DEIN-SCHLUESSEL
#
#   OpenAI:
#   LLM_MODEL=openai/gpt-4o
#   LLM_API_BASE=
#   LLM_API_KEY=DEIN-SCHLUESSEL
#
#   Lokal mit Ollama (Start mit --profile ollama, Modell einmal laden:
#   docker compose --profile ollama exec ollama ollama pull llama3.1:8b):
#   LLM_MODEL=ollama/llama3.1:8b
#   LLM_API_BASE=http://ollama:11434
#   LLM_API_KEY=

# Ähnlichkeitssuche: optionale Stufe der Suche nach dem Ordner und vor dem Internet, nur ohne
# Dokumentenarchiv. Der Suchdienst gehört NICHT zu diesem Repository; wer einen eigenen hat, trägt
# hier seine Adresse ein (Schnittstelle in docs/api.md). Leer = Stufe aus.
SEARCH_URL=

# Websuche auf der Herstellerseite: höchstens so viele Anfragen je Teil (0 = aus, Obergrenze 50).
# Der Anwender kann den Wert beim Start der Suche in der Oberfläche ändern.
INTERNET_VERSUCHE_PRO_TEIL=10
# Einstieg der Websuche: die mitgelieferte SearXNG-Instanz (Dienst „searxng“). {q} ist die
# Suchanfrage. Leer = Startseite des Herstellers (findet deutlich weniger).
INTERNET_SUCH_URL=http://searxng:8080/search?q={q}
# 1 = das Sprachmodell (config/modelle.yaml oder LLM_* oben) wählt auf einer Seite des
# Herstellers den Link, der am ehesten zum gesuchten Dokument führt. Was ein Fund ist, prüft
# weiter der Code. Mit 0, oder wenn das Modell nicht antwortet, gelten die festen Regeln im Code.
INTERNET_LLM=0
# 1 = Seiten und PDFs über einen echten (Headless-)Browser laden (Playwright). Besteht die
# Cloudflare-Prüfung der Hersteller. Leer = ehrliche httpx-Abrufe (werden von den Herstellern gesperrt).
INTERNET_BROWSER=1

# Suchlink „Websuche“, den der Anwender im eigenen Browser öffnet; {q} ist die Suchanfrage
WEBSUCHE_URL=https://duckduckgo.com/?q={q}

# Texterkennung (OCR) für gescannte PDFs: 1 = an, 0 = aus. Sprachen für Tesseract, mit „+“
OCR=1
OCR_SPRACHEN=deu+eng+fra

# --- Versand der E-Mails (Anfragen an Hersteller, Erinnerungen, Mängelliste an den Einkauf) ---
# Ohne Angaben landet alles im Test-Postfach Mailpit (Dienst „mail“, http://localhost:8025),
# nichts verlässt den Rechner. Für ein echtes Postfach Host, Port, Sicherheit, Benutzer und
# Passwort setzen. Das Passwort gehört nur in die Datei .env, nie in diese Vorlage und nie ins
# Repository.
# Beispiel für ein echtes Postfach:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SICHERHEIT=starttls
#   SMTP_BENUTZER=atex-agent@example.com
#   SMTP_PASSWORT=<nur in .env eintragen>
SMTP_HOST=mail
SMTP_PORT=1025
# keine (Mailpit), starttls (meist Port 587) oder ssl (meist Port 465). Ein anderer Wert hält
# den Start des Backends mit einer Fehlermeldung an.
SMTP_SICHERHEIT=keine
# Beide leer: ohne Anmeldung. Beide gesetzt: Anmeldung am Postfach.
SMTP_BENUTZER=
SMTP_PASSWORT=
# Absenderadresse und, falls gewünscht, ein Name, der beim Empfänger als Absender erscheint
MAIL_FROM=atex-agent@example.com
MAIL_FROM_NAME=
# Antworten gehen an diese Adresse statt an den Absender (leer = an den Absender)
MAIL_ANTWORT_AN=
# Testadresse: Solange EMAIL_NUR_TEST=1 ist (unten), geht jede E-Mail an einen Hersteller an diese
# Adresse statt an den Hersteller. Mit einem echten Postfach kommt sie hier wirklich an.
MAIL_TEST_ADDRESS=test@example.com
# 1 = das Sprachmodell schreibt Anrede und Einleitung der E-Mail an den Hersteller. Die Fakten
# (Positionen, Typen, fehlende Dokumente) setzt immer der Code ein. Mit 0, oder wenn das Modell
# nicht antwortet, gilt die feste Vorlage.
EMAIL_MIT_LLM=0
# Erinnerung an den Hersteller: fällig so viele Stunden nach der letzten E-Mail (0 = sofort, für die Demo).
# Nach so vielen Erinnerungen ist die Eskalation an den Einkauf fällig (Entscheidung des Teams: eine).
ERINNERUNG_NACH_STUNDEN=48
ERINNERUNGEN_MAX=1
# Empfänger der Mängelliste an den Einkauf (fehlende Angaben der Stückliste); leer = MAIL_TEST_ADDRESS
EINKAUF_ADRESSE=

# Gesuchte und gezeigte Sprachen der Dokumente (M8), Kürzel mit Komma, wie die Spalten (d) und
# (e) der Kundenliste. Fehlt einer gefundenen Dokumentart eine davon, sucht die Suche im Ordner
# die anderen Sprachversionen und zeigt einen Hinweis; das hält nichts auf. Pflicht ist nur die
# PFLICHTSPRACHE (unten) der EU-Konformitätserklärung.
SPRACHEN=de,en


# Zertifikatsserver (zertifikatsserver/README.md): eigene Datenbank, nur lokale Entwicklung
ZERT_DB=zertifikate
ZERT_DB_USER=zert
ZERT_DB_PASSWORD=zert
# Ordnername im Altbestand = Herstellername, mit Komma getrennt
HERSTELLER_NAMEN=P+F=Pepperl+Fuchs
# Verdacht „veraltet“, wenn das Ausstellungsdatum älter ist als so viele Jahre
VERALTET_NACH_JAHREN=10
# Aktuelle Normausgaben („Norm:Jahr“ mit Jahr der IEC-Ausgabe, mit Komma), zusätzlich zu den
# Vorgaben des Teams und vor ihnen. Nur für Normen ohne Zeile in der Tabelle; danach gilt die
# Tabelle im Server (Seite „Zertifikatsserver“, PUT /api/normen). Leer = nur die Vorgaben.
AKTUELLE_NORMEN=
# Der Zertifikatsserver liest Scans mit eigener Texterkennung; OCR und OCR_SPRACHEN (oben) gelten
# für ihn mit.
# Adresse des Zertifikatsservers für das Backend (im Docker-Netz); leer = Suche ohne ihn
ZERTIFIKATSSERVER_URL=http://zertifikatsserver:5100

# Port der Oberfläche (Dienst web); auf Rechnern, wo 8000 belegt ist, z. B. 8010
WEB_PORT=8000

# Zeitzone für Uhrzeiten im Protokoll; gespeichert wird in UTC
ZEITZONE=Europe/Berlin

# Funde aus dem eigenen Bestand (Herstellerordner, Dokumentenarchiv), an denen die Vorprüfung nichts
# zu beanstanden hat, gibt der Agent selbst frei, markiert als „automatisch freigegeben“; 0 = immer ein Mensch
AUTOMATISCH_FREIGEBEN=1
# Vorprüfung: Hinweis, wenn ein Zertifikat in so vielen Tagen abläuft
ABLAUF_WARNUNG_TAGE=180
# Ab welcher Ähnlichkeit (0 bis 1) der Hersteller im Dokument als derselbe wie in der Stückliste gilt
HERSTELLER_AEHNLICHKEIT=0.9

# ────────────────────────────────────────────────────────────────
# Anmeldung (docs/architektur.md, Abschnitt „Anmeldung“)
# ────────────────────────────────────────────────────────────────
# Diese Werte sind NUR für die lokale Entwicklung. Für jeden anderen Betrieb ändern:
# SECRET_KEY zufällig erzeugen, z. B. mit
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Mit dem Entwicklungswert warnt das Backend beim Start (Sitzungen wären fälschbar).
SECRET_KEY=entwicklung-nicht-geheim
# Eine Anmeldung gilt so viele Stunden
SITZUNG_STUNDEN=12
# 1 = Sitzungs-Cookie nur über HTTPS (für den Betrieb hinter HTTPS)
SESSION_COOKIE_SECURE=
# Admin-Zugang: entsteht beim Start, wenn es diesen Anmeldenamen noch nicht gibt (auch bei
# vorhandenen Daten); ein vorhandenes Konto bleibt unverändert, sein Passwort wird nie
# zurückgesetzt. Die Werte unten sind ein ENTWICKLUNGS- UND DEMO-ZUGANG (Anmeldename = Passwort):
# für jeden anderen Betrieb ändern. Solange das Konto „admin“ dieses Passwort hat, warnt das
# Backend beim Start. Weitere Konten in der Oberfläche unter „Benutzer“ anlegen.
ADMIN_BENUTZER=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORT=admin

# Herstellerkontakte: „1“ (Standard) = jede E-Mail an einen Hersteller geht an MAIL_TEST_ADDRESS,
# der Entwurf nennt die Adresse des Herstellers nur. „0“ schickt wirklich an den Hersteller,
# in dieser Umgebung nicht setzen. Ohne gespeicherte Adresse wird nie gesendet.
EMAIL_NUR_TEST=1
# Pflichtsprache der EU-Konformitätserklärung (M8, Entscheidung des Teams): ohne diese Fassung
# ist eine Position nicht vollständig. SPRACHEN oben sind nur die gesuchten und gezeigten Sprachen.
PFLICHTSPRACHE=de

# Dokumentenarchiv (zertifikatsserver): Adresse der Oberfläche, wie sie im Browser steht. Daraus
# baut die Kundenliste die Links in der Spalte „DL-Link“ (<Adresse>/zert/api/dokumente/<id>/datei);
# leer = http://localhost:<WEB_PORT>. Auf einem Server die echte Adresse eintragen.
OEFFENTLICHE_ADRESSE=
# Größte Datei, die das Dokumentenarchiv annimmt (MB)
DATEI_MAX_MB=50
